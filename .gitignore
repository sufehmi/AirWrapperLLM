# ── AirWrapperLLM .gitignore ────────────────────────────────────────

# Secrets / API keys
*.api_key
.airwrapper_api_key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Model weights — never commit these
/models/
**/snapshots/
**/splitted_model/
*.safetensors
*.bin
*.pt
*.pth

# Local config
.env
.env.*
!.env.example

# Logs / runtime
*.log
logs/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp