# ── AirWrapperLLM config template ────────────────────────────────────
# Copy to .env and edit. Anything left blank falls back to CLI flags.

# Local path to a downloaded Hugging Face checkpoint.
AIRWRAPPER_MODEL=/workspace/kimi-k3

# HTTP bind address and port.
AIRWRAPPER_HOST=0.0.0.0
AIRWRAPPER_PORT=20002

# CUDA device for AirLLM to stream into.
AIRWRAPPER_DEVICE=cuda:0

# AirLLM compression (None / 4bit / 8bit). 4bit halves model size and gives
# ~3x speedup, but disables layer prefetching.
AIRWRAPPER_COMPRESSION=4bit

# After the first load, delete the original HF snapshot to save disk.
AIRWRAPPER_DELETE_ORIGINAL=1

# Runtime dtype. Leave blank for auto (bf16 recommended for modern models).
AIRWRAPPER_DTYPE=bfloat16

# Maximum sequence length (context window + generation). Memory usage of
# attention layers scales with this; Mamba/SSM layers do not.
AIRWRAPPER_MAX_SEQ_LEN=32768

# Where the auto-generated API key is read/written.
AIRWRAPPER_API_KEY_FILE=/workspace/.airwrapper_api_key